# Safe defaults are intentionally incomplete for deploy/production.
AG_ENV=deploy
AG_HOST=0.0.0.0
AG_PORT=8080
AG_AUTH_PROFILE=deploy
AG_MAX_UPLOAD_BYTES=16777216

# Supply values through the deployment secret/configuration manager.
DATABASE_URL=postgresql://db-host:5432/ag_datovka
OBJECT_STORE_URL=s3://ag-datovka-content
QUEUE_URL=redis://queue-host:6379/0

